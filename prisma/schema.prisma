generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Authentification ────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  motDePasse   String
  plan         String    @default("gratuit")
  role         String    @default("user")
  suspendu     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Réinitialisation de mot de passe : on stocke le hash du token (pas le token
  // brut) pour pouvoir retrouver l'utilisateur par égalité exacte sans jamais
  // conserver de secret en clair en base — même principe qu'un mot de passe.
  resetTokenHash   String?   @unique
  resetTokenExpire DateTime?

  codeParrainage String?  @unique
  // Parrainage : générations bonus offertes au parrain (indépendantes du quota
  // journalier gratuit), créditées une fois par filleul inscrit — consommées
  // en priorité une fois le quota du jour épuisé. Voir app/api/parrainage et
  // app/api/dossiers/generer.
  generationsBonus Int    @default(0)

  // Attribution d'acquisition — capturée UNE SEULE FOIS à la création du compte
  // (jamais réécrite ensuite), via le cookie mw_ref posé sur /inscription à
  // partir du ?ref= des CTA publics. Sert à mesurer le funnel fiche publique
  // (Google) → clic CTA → inscription, sans outil d'analytics tiers.
  //   sourceAcquisition : "offre" | "categorie" | "pays" | null (direct/inconnu)
  //   refAcquisition    : slug de l'offre/catégorie/pays concernée
  sourceAcquisition String?
  refAcquisition    String?

  profils      Profil[]
  documents    Document[]
  interactions Interaction[]
  dossiers     Dossier[]
  quotas       QuotaUsage[]
  paiements    Paiement[]
  messages     Message[]
  sessions     SessionActivity[]
  pushSubs     PushSubscription[]
  alertesEnvoyees AlerteEnvoyee[]
  parrainagesEnvoyes Parrainage[] @relation("parrainages_envoyes")
  parrainagesRecus   Parrainage[] @relation("parrainages_recus")
  organisme    Organisme?

  @@map("users")
}

// ─── Profil candidat ─────────────────────────────────────────────────────────

model Profil {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Multi-profils (Pro) : un utilisateur peut avoir plusieurs profils complets
  // (ex. "Génie civil", "Comptabilité"), chacun avec ses propres formations/
  // expériences/compétences. `actif` marque celui utilisé par défaut pour le
  // fil, le contrôle de compatibilité et la génération de dossier — au plus un
  // profil actif par utilisateur, garanti en code (voir lib/profil/actif.ts),
  // pas en contrainte DB (Postgres ne fait pas d'unique partiel via Prisma).
  nom         String   @default("Profil principal")
  actif       Boolean  @default(true)

  nomComplet    String?
  dateNaissance String?
  lieuNaissance String?
  nationalite   String?
  telephone     String?
  adresse       String?
  email         String?
  signature     String?  // nom tel que le candidat signe (peut différer du nom complet)
  linkedin      String?
  bio           String?
  formations    String   @default("[]")
  experiences   String   @default("[]")
  competences   String   @default("[]")
  langues       String   @default("[]")
  objectifs     String?
  tonSouhaite   String?
  complete      Boolean  @default(false)
  sessionOnboarding String @default("[]")
  // Modèle de mise en page choisi pour le PDF du CV : classique | sidebar | bandeau
  // (voir lib/pdf/cv-templates.ts). Ne change pas le contenu généré par l'IA, seulement
  // sa présentation visuelle au moment du téléchargement.
  modeleCv      String   @default("classique")
  // Brief général de projet (JSON) collecté par Blessing AVANT de débloquer le swipe
  // dans la catégorie "Appels à projets" — voir /onboarding-projet. Sert de garde-fou :
  // sans ça, le candidat swipait des appels à projets sans jamais avoir décrit son
  // projet, donc sans rien de réel pour générer une note conceptuelle pertinente.
  profilProjet  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("profils")
}

// ─── Coffre-fort de documents ────────────────────────────────────────────────

model Document {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  type           String
  nomFichier     String
  refStockage    String    @default("")
  contenuChiffre Bytes?
  taille         Int?
  infosExtraites String?
  extraitParIa   Boolean   @default(false)

  createdAt      DateTime  @default(now())

  @@index([userId])
  @@map("documents")
}

// ─── Opportunités (extensible — pages/API construites à l'étape 2) ───────────

model Opportunite {
  id             String      @id @default(cuid())
  type           String      @default("BOURSE")
  source         String
  organisme      String
  intitule       String
  description    String
  intituleFr     String?
  descriptionFr  String?
  // Slug SEO public (/offres/[slug]), permanent : jamais réattribué même après
  // expiration de l'offre, pour ne pas casser les URLs déjà indexées par Google.
  // Nullable le temps du backfill des lignes existantes ; auto-généré à la
  // création par l'extension Prisma dans lib/prisma.ts.
  slug           String?     @unique
  // Code pays ISO-3166 alpha-2 de la localisation de l'offre (pas la nationalité
  // du candidat), auto-détecté par mots-clés à la création (voir lib/pays.ts).
  // Alimente le JSON-LD jobLocation et les pages publiques /offres/pays/[slug].
  pays           String?
  // Modalité (presentiel | en_ligne | hybride | teletravail), auto-détectée par
  // mots-clés à la création (voir lib/modalite.ts). Combinable en query param
  // (?modalite=) sur les pages catégorie/pays. Souvent null : heuristique
  // volontairement prudente, mieux vaut absent qu'un faux positif.
  modalite       String?
  // Domaine(s) d'étude/emploi (droit, maths-info, santé...), JSON array de
  // slugs — classé par IA au moment où l'offre passe en "publiee" (voir
  // lib/prisma.ts et lib/ia/classification-domaines.ts), jamais à la simple
  // création : évite de payer un appel IA sur une offre qui ne sera jamais
  // publiée (rejetée, doublon...). Liste des slugs valides : lib/domaines.ts.
  domaines       String      @default("[]")
  // Texte source original (page scrapée / offre collée), AVANT résumé IA. `description`
  // reste un résumé condensé pour l'affichage (fil de swipe) ; `contenuBrut` est ce qui
  // doit être utilisé à la génération des documents pour coller aux exigences réelles
  // de l'offre, au lieu de ne travailler que sur un résumé déjà appauvri.
  contenuBrut    String?
  langueDetectee String?
  conditions     String?
  piecesExigees  String      @default("[]")
  exigenceLangue String?
  // dateLimite = la date LIMITE de candidature (validité de l'offre). Reste l'unique
  // source de vérité pour « jusqu'à quand candidater » (rempli par l'IA ou l'admin).
  dateLimite     DateTime?
  lien           String?
  // Canal de candidature (étape 3) : comment postuler, et la cible associée.
  //   email | formulaire | lien_info | aucun  (null = non analysé)
  canalCandidature String?
  cibleCandidature String?   // adresse e-mail OU URL selon le canal
  actif          Boolean     @default(true)
  // Cycle de vie de l'offre :
  //   a_valider      → en file admin (date limite future, fiable)
  //   revue_manuelle → en file admin, SIGNALÉ : date absente/incertaine, l'admin la fixe
  //   publiee        → visible dans le fil (seul l'admin y fait passer)
  //   expiree        → date limite dépassée après publication
  //   rejetee        → écartée (déjà close à l'ingestion, ou rejetée par l'admin)
  statut         String      @default("publiee")
  sourceUrl      String?     // URL d'origine (item du flux)
  hash           String?     @unique // ancienne dédup (sha1) — conservée pour compat
  // ─── Ingestion : récence (quand on l'a vue) vs validité (date limite) ───────
  dedupKey            String?   @unique // clé de dédup canonique : guid:/url:/hash:
  premiereVue         DateTime  @default(now()) // first_seen_at — fixé une seule fois, jamais déplacé
  datePublication     DateTime? // published_at — date du flux, AFFICHAGE seulement
  confianceDateLimite Float?    // deadline_confidence — 0 à 1 (fiabilité de la date extraite)
  sourceDateLimite    String?   // deadline_source — d'où vient la date (flux, IA, page liée…)
  derniereVerif       DateTime? // last_checked_at — dernier passage d'ingestion sur cet item
  fluxSourceId   String?
  fluxSource     FluxSource? @relation(fields: [fluxSourceId], references: [id], onDelete: SetNull)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  interactions   Interaction[]
  dossiers       Dossier[]
  article        Article?
  alertesEnvoyees AlerteEnvoyee[]

  @@index([statut])
  @@index([pays])
  @@index([modalite])
  @@index([type, actif, statut, dateLimite])
  @@map("opportunites")
}

// ─── Blog : articles générés automatiquement (scénario Make) à la publication
// d'une offre, ou ajoutés à la main depuis le back-office. ────────────────────

model Article {
  id              String       @id @default(cuid())
  // Slug SEO public (/blog/[slug]), généré côté serveur à la création
  // (jamais fourni par l'appelant) — voir lib/slug.ts genererSlugArticle.
  slug            String       @unique
  titre           String
  extrait         String
  contenu         String       // Markdown
  imageCouverture String?
  categorie       String?      // conseils | actualite | bourse | ...
  motsCles        String       @default("[]") // JSON array de strings
  statut          String       @default("publie") // publie | archive
  seoTitre        String?
  seoDescription  String?

  // Offre source (optionnelle) ayant déclenché la génération de l'article.
  // Unique : au plus un article par offre, pour ne pas dupliquer en cas de
  // double déclenchement du webhook Make.
  opportuniteId   String?      @unique
  opportunite     Opportunite? @relation(fields: [opportuniteId], references: [id], onDelete: SetNull)

  publieLe        DateTime     @default(now())
  // Marqué quand le scénario Make "sélection Facebook quotidienne" relaie
  // effectivement cet article — sert à la fois de statut (relayé ou pas) et
  // de garde-fou anti-double-post. Null = jamais relayé.
  facebookPostedLe DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([statut])
  @@map("articles")
}

// ─── Sources de flux (RSS/XML) — back-office admin ───────────────────────────

model FluxSource {
  id           String        @id @default(cuid())
  nom          String
  url          String
  type         String        @default("rss") // format : rss | xml
  categorie    String        @default("BOURSE") // catégorie d'opportunités produite : BOURSE | EMPLOI | FORMATION | CONCOURS | STAGE | RESIDENCE | ADMISSION
  actif        Boolean       @default(true)
  etat         String        @default("inconnu") // ok | panne | inconnu
  dernierFetch DateTime?
  message      String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  opportunites Opportunite[]

  @@map("flux_sources")
}

// ─── Réglages globaux du SaaS (clé/valeur) — back-office admin ───────────────

model Parametre {
  cle       String   @id
  valeur    String
  updatedAt DateTime @updatedAt

  @@map("parametres")
}

// ─── Journal des actions admin (audit trail) ─────────────────────────────────

model JournalAdmin {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  cible     String?
  details   String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@map("journal_admin")
}

// ─── Interactions (swipe) — étape 2 ─────────────────────────────────────────

model Interaction {
  id            String      @id @default(cuid())
  userId        String
  opportuniteId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunite   Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  decision      String
  createdAt     DateTime    @default(now())

  @@unique([userId, opportuniteId])
  @@index([userId, decision])
  @@map("interactions")
}

// ─── Dossiers de candidature — étape 3 ──────────────────────────────────────

model Dossier {
  id            String        @id @default(cuid())
  userId        String
  opportuniteId String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunite   Opportunite   @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  statut        String        @default("A_PREPARER")
  checklist     String?
  briefProjet   String?
  // Relance automatique (Pro) : posé une seule fois quand le rappel de relance
  // a été envoyé, pour ne jamais renotifier deux fois le même dossier.
  relanceEnvoyeeLe DateTime?
  // Checklist post-obtention : `dateObtention` posée quand l'utilisateur
  // marque l'offre comme obtenue (déclenche la génération de la checklist,
  // voir lib/checklist-post-obtention.ts) ; `checklistRelanceEnvoyeeLe` évite
  // de renotifier deux fois le rappel « il vous reste des étapes ».
  dateObtention DateTime?
  checklistRelanceEnvoyeeLe DateTime?
  etapesPostObtention EtapePostObtention[]
  docsGeneres   DocumentGenere[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, updatedAt])
  @@map("dossiers")
}

// Checklist post-obtention (Pro) : étapes générées automatiquement selon le
// type d'offre (visa, documents administratifs, logement...) quand le
// candidat marque un dossier comme « obtenu ». Voir lib/checklist-post-obtention.ts.
model EtapePostObtention {
  id        String  @id @default(cuid())
  dossierId String
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  texte     String
  // Slug d'un guide Matchwork existant (lib/guides.ts) à afficher en lien,
  // null si l'étape n'a pas de guide correspondant.
  lienGuide String?
  fait      Boolean @default(false)
  ordre     Int     @default(0)

  createdAt DateTime @default(now())

  @@index([dossierId])
  @@map("etapes_post_obtention")
}

model DocumentGenere {
  id        String   @id @default(cuid())
  dossierId String
  dossier   Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  type      String
  contenu   String
  langue    String
  accroches String   @default("[]")

  createdAt DateTime @default(now())

  @@map("documents_generes")
}

// ─── Quota gratuit — réinitialisé chaque jour ────────────────────────────────
// Le champ `mois` est un nom historique trompeur : il contient en réalité une
// date "AAAA-MM-JJ" (voir `jour` dans app/api/dossiers/generer/route.ts), pas
// un mois. Conservé tel quel pour éviter un renommage de colonne à risque —
// c'est bien un quota JOURNALIER (3 générations/jour par défaut).
model QuotaUsage {
  id                   String @id @default(cuid())
  userId               String
  user                 User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mois                 String
  generationsUtilisees Int    @default(0)

  @@unique([userId, mois])
  @@map("quota_usage")
}

// ─── Paiements — étape 4 ─────────────────────────────────────────────────────

model Paiement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  montant     Float
  fournisseur String   @default("fedapay")
  plan        String   @default("pro")
  statut      String   @default("en_attente")
  reference   String?
  fedapayId   Int?

  createdAt   DateTime @default(now())

  @@map("paiements")
}

// ─── Messagerie (organisme ↔ candidat) ───────────────────────────────────────

model Message {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  auteur    String   // "candidat" | "organisme" | "systeme"
  nomAuteur String   // nom affiché de l'interlocuteur (organisme / Matchwork)
  contenu   String
  lu        Boolean  @default(false)

  // Clé de thread réelle pour les échanges organisme ↔ candidat (nomAuteur
  // reste la clé utilisée côté candidat pour grouper visuellement, mais n'est
  // qu'une chaîne libre — organismeId permet à l'organisme de retrouver ses
  // propres conversations de façon fiable, et sert de frontière d'autorisation
  // (un organisme ne peut lire/écrire que les messages où il est partie).
  // Null pour les messages système/support Matchwork.
  organismeId String?
  organisme   Organisme? @relation(fields: [organismeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([organismeId])
  @@map("messages")
}

// ─── Tracking de session (temps passé sur le SaaS) ──────────────────────────

model SessionActivity {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  debutAt DateTime @default(now())
  finAt   DateTime @default(now())
  dureeMs Int      @default(0)

  @@index([userId])
  @@index([debutAt])
  @@map("session_activities")
}

// ─── Notifications push (web push) ──────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// Déduplication des alertes intelligentes (push Pro sur offre à fort score) —
// évite de renotifier un même utilisateur pour une même offre à chaque
// passage du cron.
model AlerteEnvoyee {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportuniteId String
  opportunite   Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([userId, opportuniteId])
  @@index([userId])
  @@map("alertes_envoyees")
}

// ─── Parrainage ─────────────────────────────────────────────────────────────

model Parrainage {
  id          String   @id @default(cuid())
  parrainId   String
  parrain     User     @relation("parrainages_envoyes", fields: [parrainId], references: [id], onDelete: Cascade)
  filleulId   String?
  filleul     User?    @relation("parrainages_recus", fields: [filleulId], references: [id], onDelete: SetNull)
  code        String   @unique
  statut      String   @default("en_attente") // en_attente | inscrit | actif
  createdAt   DateTime @default(now())

  @@index([parrainId])
  @@map("parrainages")
}

// ─── Portail B2B (organismes qui publient directement) ──────────────────────

model Organisme {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nom         String
  type        String   @default("universite") // universite | ong | entreprise | gouvernement
  pays        String?
  siteWeb     String?
  logo        String?
  verifie     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    Message[]

  @@map("organismes")
}

// ─── Cache des réponses IA ──────────────────────────────────────────────────

// Une même offre est traduite, extraite et classée par tous les points
// d'entrée (RSS, scrapers, « coller une offre », ré-ingestion), et analysée à
// l'identique pour chaque candidat qui la consulte. La clé est l'empreinte du
// prompt complet : deux appels identiques ne sont facturés qu'une fois.
// Ne concerne QUE les tâches déterministes — jamais une lettre ou un CV, qui
// doivent rester propres à un candidat.
model CacheIA {
  cle         String   @id // sha256(tache + niveau + system + user)
  tache       String
  reponse     String // JSON sérialisé de la réponse déjà parsée
  fournisseur String?
  createdAt   DateTime @default(now())

  @@index([tache])
  @@map("cache_ia")
}
